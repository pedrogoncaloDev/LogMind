{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI (local, sem Docker)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/back_end"
            },
            "cwd": "${workspaceFolder}/back_end"
        },
        {
            "name": "Python: Attach ao container (Docker)",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/back_end",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": true
        }
    ]
}
